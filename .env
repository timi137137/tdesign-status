# 打包路径 根据项目不同按需配置
VITE_BASE_URL = /
VITE_IS_REQUEST_PROXY = true
VITE_API_URL = https://service-bv448zsw-1257786608.gz.apigw.tencentcs.com
VITE_API_URL_PREFIX = /api

# NODE_ENV 不要写在这里：这个文件同时被 Vite 构建读取（Vite 会从 .env 取 NODE_ENV），
# 写 development 会让 `npm run build` 产出开发版 bundle（打包进 Vue 开发构建）。
# 服务端默认就是 development；生产环境由平台的环境变量提供。
STATUS_HOST=127.0.0.1
STATUS_PORT=3000
STATUS_DB_PATH=./server/data/status.db
STATUS_ADMIN_USERNAME=admin
STATUS_ADMIN_PASSWORD=StatusAdmin12
STATUS_ADMIN_DISPLAY_NAME=管理员
STATUS_ADMIN_MUST_CHANGE=false
STATUS_COOKIE_SECURE=false
STATUS_SESSION_HOURS=12
STATUS_ALLOWED_ORIGINS=http://127.0.0.1:3002,http://localhost:3002
STATUS_TRUST_PROXY=false