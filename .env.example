# 仅列出变量名。请在未提交的 .env 中填写真实值。
NODE_ENV=development
STATUS_HOST=127.0.0.1
STATUS_PORT=3000
STATUS_DB_PATH=./server/data/status.db
STATUS_ADMIN_USERNAME=
STATUS_ADMIN_PASSWORD=
STATUS_ADMIN_DISPLAY_NAME=
STATUS_ADMIN_MUST_CHANGE=true
STATUS_COOKIE_SECURE=false
STATUS_SESSION_HOURS=12
STATUS_ALLOWED_ORIGINS=http://127.0.0.1:3002,http://localhost:3002
# Fastify trustProxy：false=不信任 X-Forwarded-For（直连部署用这个）；
# true=只信任 1 跳（托管平台边缘代理）；也可填跳数（如 2）或可信代理地址/CIDR 列表
# （如 127.0.0.1,10.0.0.0/8）。只有"每个请求都经过一个会追加 X-Forwarded-For 的可信代理"
# 时才应开启，否则客户端可伪造来源 IP 绕过按 IP 的限流。
STATUS_TRUST_PROXY=false
STATUS_AUTO_SEED=false
# 监控探针：默认关闭。开启后按 service_probes 表里的点位定义周期探测，
# 结果写入样本并聚合到服务状态。
STATUS_PROBES_ENABLED=false
STATUS_PROBE_INTERVAL_SECONDS=60
STATUS_PROBE_TIMEOUT_MS=5000
STATUS_PROBE_CONCURRENCY=4

VITE_BASE_URL=/
VITE_API_URL_PREFIX=/api
VITE_IS_REQUEST_PROXY=true
