{
  "name": "@tencent/tdesign-vue-next-starter",
  "version": "0.8.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite --open --mode development",
    "dev:server": "tsx watch --exclude ./server/data --tsconfig server/tsconfig.json server/index.ts",
    "dev:linux": "vite --mode development",
    "start": "tsx --tsconfig server/tsconfig.json server/index.ts",
    "start:test": "tsx --tsconfig server/tsconfig.json server/index.ts",
    "db:migrate": "tsx --tsconfig server/tsconfig.json server/db/migrate.ts",
    "db:seed": "tsx --tsconfig server/tsconfig.json server/db/seed.ts",
    "build:test": "vite build --mode test",
    "build": "vue-tsc --noEmit && vite build --mode release",
    "build:site": "vue-tsc --noEmit && vite build --mode site",
    "preview": "vite preview",
    "lint": "eslint --ext .vue,.js,.jsx,.ts,.tsx src server tests scripts --max-warnings 0",
    "lint:fix": "eslint --ext .vue,.js,.jsx,.ts,.tsx src server tests scripts --max-warnings 0 --fix",
    "stylelint": "stylelint \"src/**/*.{html,vue,sass,less}\"",
    "stylelint:fix": "stylelint --fix \"src/**/*.{html,vue,css,sass,less}\"",
    "prepare": "is-ci || husky install",
    "site:preview": "npm run build && cp -r dist _site",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "lhci": "lhci autorun",
    "budget": "node scripts/check-bundle-budget.mjs"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "axios": "^1.4.0",
    "better-sqlite3": "^13.0.3",
    "dayjs": "^1.11.23",
    "drizzle-orm": "^0.45.2",
    "echarts": "5.1.2",
    "fastify": "^5.12.1",
    "is-ci": "^4.1.0",
    "lodash": "^4.17.21",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "qrcode.vue": "^3.4.0",
    "qs": "^6.11.2",
    "tdesign-icons-vue-next": "^0.4.10",
    "tdesign-vue-next": "^1.20.6",
    "tsx": "^4.23.12",
    "tvision-color": "^1.6.0",
    "vue": "^3.5.41",
    "vue-clipboard3": "^2.0.0",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@babel/core": "7.29.7",
    "@babel/generator": "7.29.8",
    "@commitlint/cli": "^17.6.6",
    "@commitlint/config-conventional": "^17.6.6",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/echarts": "^4.9.18",
    "@types/lodash": "^4.14.195",
    "@types/nprogress": "^0.2.0",
    "@types/qs": "^6.9.7",
    "@typescript-eslint/eslint-plugin": "^5.61.0",
    "@typescript-eslint/parser": "^5.61.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/compiler-sfc": "^3.5.41",
    "@vue/eslint-config-typescript": "^11.0.3",
    "commitizen": "^4.3.0",
    "cz-conventional-changelog": "^3.3.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^8.44.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^10.0.0",
    "eslint-plugin-vue": "^9.15.1",
    "eslint-plugin-vue-scoped-css": "^2.5.0",
    "husky": "^8.0.3",
    "less": "^4.9.0",
    "lint-staged": "^13.2.3",
    "mockjs": "^1.1.0",
    "postcss-html": "^1.5.0",
    "postcss-less": "^6.0.0",
    "prettier": "^2.8.8",
    "stylelint": "~15.10.0",
    "stylelint-config-standard": "^34.0.0",
    "stylelint-order": "~6.0.3",
    "typescript": "^5.9.3",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.2.2",
    "vite-plugin-mock": "^3.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vite-svg-loader": "^5.1.1",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  },
  "engines": {
    "node": ">=20"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "*.{js,jsx,vue,ts,tsx}": [
      "prettier --write",
      "eslint --fix --max-warnings 0"
    ],
    "*.{html,vue,css,sass,less}": [
      "stylelint --fix"
    ]
  }
}
